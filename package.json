{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:test": "tsx scripts/run-test-server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test:integrity": "tsx test-integrity.ts",
    "test:auth": "tsx test-auth-stabilization.ts",
    "test:schema": "tsx scripts/verify-vnext-schema.ts",
    "test:schema:test": "set VERIFY_TEST_DATABASE=NEXUS_TEST_DATABASE&& tsx scripts/verify-vnext-schema.ts",
    "test:enrollment-policy": "tsx tests/enrollment-policy.test.ts",
    "test:person-resolution": "tsx tests/person-resolution.test.ts",
    "test:person-resolution-access": "tsx tests/person-resolution-access.test.ts",
    "test:database:setup": "tsx scripts/setup-test-database.ts",
    "test:identity": "tsx scripts/seed-test-institutional-identity.ts",
    "migrate:audit": "tsx scripts/apply-audit-observability-migration.ts",
    "migrate:enrollment": "tsx scripts/apply-enrollment-migration.ts",
    "migrate:enrollment:test": "tsx scripts/apply-enrollment-test-migration.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
