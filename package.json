{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:test": "tsx scripts/run-test-server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "nexus:preflight": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/nexus-preflight.ts",
    "nexus:migrate": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/nexus-migrate.ts --target=DATABASE_URL",
    "nexus:preflight:db:test:safety": "node scripts/nexus-test-db-safety.mjs",
    "test:fnd01:cp2:postgres": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/fnd01-cp2-postgres.test.mjs",
    "test:fnd01:cp2:local": "node scripts/run-fnd01-cp2-local.mjs",
    "test:fnd01:cp4:postgres": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/fnd01-cp4-school-tasks-postgres.test.mts",
    "nexus:preflight:db": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/nexus-preflight.ts --require-db && node scripts/nexus-preflight-db.mjs --target=DATABASE_URL",
    "test:integrity": "tsx test-integrity.ts",
    "test:auth": "tsx test-auth-stabilization.ts",
    "test:schema": "tsx scripts/verify-vnext-schema.ts",
    "test:schema:test": "set VERIFY_TEST_DATABASE=NEXUS_TEST_DATABASE&& tsx scripts/verify-vnext-schema.ts",
    "test:enrollment-policy": "tsx tests/enrollment-policy.test.ts",
    "test:person-resolution": "tsx tests/person-resolution.test.ts",
    "test:person-resolution-access": "tsx tests/person-resolution-access.test.ts",
    "test:enrollment-intake": "tsx tests/enrollment-intake.test.ts",
    "test:identity-resolution-decision": "tsx tests/identity-resolution-decision.test.ts",
    "test:enrollment-intake-api": "tsx tests/enrollment-intake-api-contract.test.ts",
    "test:enrollment-intake-api:postgres": "tsx tests/enrollment-intake-api-postgres.test.ts",
    "test:t6": "npm run test:person-resolution && npm run test:person-resolution-access && npm run test:enrollment-intake && npm run test:identity-resolution-decision && npm run test:enrollment-intake-api && npm run test:enrollment-intake-api:postgres && npm run test:migrations:isolated && npm run lint && npm run build",
    "apply:enrollment-vnext-layer1": "tsx scripts/apply-enrollment-vnext-layer1-shell.ts",
    "fix:enrollment-vnext-layer1": "tsx scripts/fix-enrollment-vnext-layer1-typescript.ts",
    "apply:secretariat-s01": "tsx scripts/apply-secretariat-s01-visual-integrity.ts",
    "apply:secretariat-s01-1": "tsx scripts/apply-secretariat-s01-1-responsive-interaction.ts",
    "apply:secretariat-s01-2": "tsx scripts/apply-secretariat-s01-2-flow-simplification.ts",
    "diagnose:secretariat-institution": "tsx scripts/diagnose-secretariat-institution-name.ts",
    "test:secretariat-s01-visual": "tsx tests/secretariat-s01-visual-contract.test.ts",
    "test:secretariat-s01-1": "tsx tests/secretariat-s01-1-responsive-interaction.test.ts && npm run test:secretariat-s01",
    "test:secretariat-s01-2": "tsx tests/secretariat-s01-2-flow-simplification.test.ts && npm run test:secretariat-s01-1",
    "test:secretariat-s01": "npm run test:secretariat-s01-visual && npm run test:enrollment-vnext-layer1",
    "test:enrollment-operations-model": "tsx tests/enrollment-operations-model.test.ts",
    "test:enrollment-operations-ui": "tsx tests/enrollment-operations-ui-contract.test.ts",
    "test:enrollment-vnext-layer1": "npm run test:enrollment-operations-model && npm run test:enrollment-operations-ui && npm run test:t6",
    "test:migrations:isolated": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/verify-migrations-isolated.ts",
    "test:database:setup": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/setup-test-database.ts",
    "test:identity": "tsx scripts/seed-test-institutional-identity.ts",
    "migrate:audit": "tsx scripts/apply-audit-observability-migration.ts",
    "migrate:enrollment": "tsx scripts/apply-enrollment-migration.ts",
    "migrate:enrollment:test": "tsx scripts/apply-enrollment-test-migration.ts",
    "lint": "tsc --noEmit",
    "nexus:preflight:db:test": "node scripts/nexus-preflight-db.mjs --target=TEST_DATABASE_URL",
    "nexus:migrate:s02:test": "node scripts/apply-s02-schema-reconciliation.mjs --target=TEST_DATABASE_URL",
    "test:s02:schema-regression": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/secretariat-s02-existing-student-schema-postgres.test.ts",
    "test:secretariat-s03:policy": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/secretariat-s03-process-policy.test.ts",
    "test:secretariat-s03:postgres": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/secretariat-s03-process-postgres.test.ts",
    "test:secretariat-s03:contract": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx tests/secretariat-s03-process-contract.test.ts",
    "test:secretariat-s03": "npm run test:secretariat-s03:policy && npm run test:secretariat-s03:contract && npm run test:secretariat-s03:postgres",
    "nexus:migrate:s03:test": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/apply-s03-process-migration.ts --target=TEST_DATABASE_URL",
    "nexus:migrate:s03": "node --import \"data:text/javascript,process.geteuid%3D()%3D%3E0\" --import tsx scripts/apply-s03-process-migration.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
