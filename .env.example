# Ambiente: development | staging | production
NODE_ENV="development"

# PostgreSQL oficial (Supabase/Cloud SQL). Obrigatório em staging e produção.
# Nunca colocar a password no Git.
DATABASE_URL=""

# Só para desenvolvimento local sem base de dados. Nunca ativar em staging/produção.
ALLOW_IN_MEMORY_FALLBACK="false"

# Exclusivo para testes que criam e removem dados. Tem de ser uma base separada
# da produção e só é usada se a confirmação explícita também estiver definida.
TEST_DATABASE_URL=""
TEST_DATABASE_CONFIRMATION=""

# Token de segurança para operações de limpeza de dados (gerar string aleatória longa)
SYSTEM_WIPE_TOKEN=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Supabase PostgreSQL Connection Credentials
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backup signature validation secret for school-tasks disaster recovery
BACKUP_SECRET_KEY="YOUR_SECURE_BACKUP_SECRET_KEY"

# SMTP Mailer Configurations (Optional, falls back to secure simulation console if empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexusEduAI <noreply@nexuseduai.com>"

